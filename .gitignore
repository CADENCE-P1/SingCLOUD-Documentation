# Profiler output — read it before committing anything from it.
# Free-text columns can contain patient detail; see tools/README.md.
data_catalog_output/
*.checkpoint.json

# Data. Never commit patient-level extracts of any kind to this repository.
#
# *.csv is deliberately NOT ignored: the profiler's own summary CSVs
# (source_material/imported/*.csv) are metadata about datasets — column names,
# types, missingness — and belong here. The trade-off is that this file no
# longer stops a real data extract from being committed by accident. Check what
# a .csv actually contains before adding it.
*.parquet
*.xlsx
*.xls
*.jsonl
*.dta
*.sav

# Credentials and environment
.env
.env.*
*.pem
credentials
aws_config

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# Personal Claude Code settings
.claude/settings.local.json
